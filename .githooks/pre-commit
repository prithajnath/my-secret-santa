#!/usr/bin/env bash
# Pre-commit hooks 
if git rev-parse --verify HEAD >/dev/null 2>&1
then
	against=HEAD
else
	# Initial commit: diff against an empty tree object
	against=$(git hash-object -t tree /dev/null)
fi

# Format the Python files you just edited!
touched_python_files=$(git status | grep modified  | awk -F ':' '{ print $2  }' | egrep py$ | sed 's/ //g')
black $touched_python_files
git add $touched_python_files


# Hook to make sure uv.lock is in sync with pyproject.toml
uv lock --check --quiet || { echo "ABORTING COMMIT :: PLEASE FIX :: uv.lock is out of date, run: uv lock" && exit 1; }

# Hook to make sure requirements.txt is always in sync with uv.lock (header comments ignored)
[ ! -z "$(diff <(uv export --format requirements.txt --frozen --quiet --no-dev | grep -v '^#') <(grep -v '^#' $(pwd)/requirements.txt))" ] && echo "ABORTING COMMIT :: PLEASE FIX :: requirements.txt needs to be in sync with uv.lock, run: uv export --format requirements.txt --no-dev -o requirements.txt" && exit 1

exit 0
